<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>app.moui.sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>{python_path}</string>
        <string>-m</string>
        <string>cli.sync.daemon.main</string>
        <string>daemon</string>
        <string>--infrastructure</string>
        <string>{infrastructure_path}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>{log_dir}/moui-sync.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>{log_dir}/moui-sync.stderr.log</string>
</dict>
</plist>
