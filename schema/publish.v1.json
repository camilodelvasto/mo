{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "publish.v1.json",
  "type": "object",
  "required": ["content", "targets"],
  "additionalProperties": false,
  "properties": {
    "content": { "type": "string" },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "adapter", "path", "url", "published_at", "status"],
        "additionalProperties": false,
        "properties": {
          "id":           { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "adapter":      { "type": "string" },
          "path":         { "type": "string", "pattern": "^/" },
          "url":          { "type": "string" },
          "encrypted":    { "type": "boolean" },
          "mnemonic":     { "type": "string" },
          "published_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "status":       { "type": "string", "enum": ["live", "unpublished"] }
        }
      }
    }
  }
}
