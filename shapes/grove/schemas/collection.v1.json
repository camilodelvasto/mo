{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "collection.v1.json",
  "title": "Moui Grove Collection",
  "description": "Curated sequence of posts. References posts by content path relative to posts/.",
  "type": "object",
  "required": ["id", "title", "posts"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "og": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": { "type": "string" }
      }
    },
    "posts": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "layout": {
      "type": "string",
      "enum": ["grid", "list"]
    },
    "featured_post": { "type": "string" }
  }
}
