{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "assert.v1.json",
  "title": "Moui Corpus Assert File",
  "type": "object",
  "required": ["doc_id", "by", "fields"],
  "additionalProperties": false,
  "properties": {
    "doc_id": { "type": "string", "pattern": "^[0-9a-f]{12}$" },
    "by": { "type": "string", "enum": ["operator"] },
    "via": { "type": "string" },
    "fields": {
      "type": "object",
      "minProperties": 1,
      "description": "Field names and value types are validated by the engine against the flow's declarations — the schema cannot know them; openness here is the boundary, not a hole."
    }
  }
}
