{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "deck.v1.json",
  "title": "Moui Deck",
  "description": "Slideshow presentation. Metadata at top level, slides array below.",
  "allOf": [
    { "$ref": "bite.v1.json" },
    {
      "type": "object",
      "required": ["title", "slides"],
      "properties": {
        "title": { "type": "string" },
        "reveal": {
          "type": "object",
          "properties": {
            "type": { "type": "string", "enum": ["fade", "slide", "rise", "none"] },
            "stagger": { "type": "boolean" },
            "speed": { "type": "number", "minimum": 0.1, "maximum": 5 }
          }
        },
        "og": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "description": { "type": "string" },
            "image": { "type": "string" }
          }
        },
        "slides": {
          "type": "array",
          "items": { "$ref": "slide.v1.json" },
          "minItems": 1
        }
      }
    }
  ]
}
