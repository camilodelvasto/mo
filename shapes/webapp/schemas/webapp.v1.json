{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "webapp.v1.json",
  "title": "Moui Webapp",
  "description": "A source folder that builds itself into a static web app.",
  "type": "object",
  "required": ["instance", "version", "schema", "build", "out"],
  "additionalProperties": false,
  "properties": {
    "instance": { "const": "webapp" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "schema": { "const": "webapp.v1.json" },
    "build": {
      "description": "Commands run in order inside the folder. Each is an argv list; no shell.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string", "minLength": 1 }
      }
    },
    "out": {
      "description": "The built static site, relative to the folder. Must hold index.html.",
      "type": "string",
      "minLength": 1
    }
  }
}
