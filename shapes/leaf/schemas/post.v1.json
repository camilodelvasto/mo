{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "post.v1.json",
  "title": "Moui Post",
  "description": "Blog post or page. Content is Markdown with frontmatter carrying bite metadata.",
  "allOf": [
    { "$ref": "bite.v1.json" },
    {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "excerpt": { "type": "string" },
        "published": { "type": "boolean" },
        "publish_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "sticky": { "type": "boolean", "description": "Pin to top of index listing." },
        "card": {
          "type": "object",
          "description": "Index card appearance overrides.",
          "properties": {
            "image": { "type": "string", "description": "Thumbnail image. Relative to grove root." },
            "bg": { "type": "string", "description": "Background color. Overrides theme card-bg." },
            "color": { "type": "string", "description": "Text color. Overrides theme text color." },
            "hover": { "type": "string", "description": "Text hover color. Overrides theme accent." }
          },
          "additionalProperties": false
        }
      }
    }
  ]
}
