#!/usr/bin/env python3
# Copyright (C) 2026 Sensata Research GmbH
# SPDX-License-Identifier: AGPL-3.0-only
"""api.claude-json on Amazon Bedrock — the synthesis ENVELOPE adapter. Reads a
prompt on stdin, calls bedrock-runtime `converse`, and maps the response to the
moui synthesis envelope on stdout (emits: envelope):

    {"answer", "model", "usage": {input_tokens, output_tokens,
     cache_read_input_tokens}, "cost_usd", "duration_ms"}

The same shape bin/claude-json emits, so the engine reads provenance, not just
text — a `synthesize: {uses: api.claude-json}` ask works unchanged whether bound
to the local Claude CLI or to Bedrock. The coupling to Bedrock's wire shape
lives HERE, in the machine binding, never in the engine. Flags: --model
<inference-profile-id> --region <aws-region> --max-tokens <int> (required output
cap; cost lives in the binding, never silently defaulted). Credentials come from
the ambient AWS chain — never hardcoded."""
import argparse
import json
import sys

from botocore.config import Config


def to_envelope(converse: dict, model: str) -> dict:
    """Map a bedrock-runtime converse() response to the moui synthesis envelope.
    Bedrock returns no per-call USD cost, so cost_usd is None — the AWS Budgets
    alarm backstops spend (see the cost backstop)."""
    blocks = converse["output"]["message"]["content"]
    answer = "".join(b.get("text", "") for b in blocks)
    usage = converse.get("usage", {})
    return {
        "answer": answer,
        "model": model,
        "usage": {
            "input_tokens": usage.get("inputTokens"),
            "output_tokens": usage.get("outputTokens"),
            "cache_read_input_tokens": usage.get("cacheReadInputTokens"),
        },
        "cost_usd": None,
        "duration_ms": (converse.get("metrics") or {}).get("latencyMs"),
    }


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--model", required=True)
    ap.add_argument("--region", required=True)
    ap.add_argument("--max-tokens", type=int, required=True)
    args = ap.parse_args()

    prompt = sys.stdin.read()
    if not prompt.strip():
        sys.stderr.write("claude-bedrock-json: empty prompt on stdin\n")
        return 1

    import boto3
    # Adaptive retry: back off + client-side throttle on Bedrock ThrottlingException so a
    # momentary throttle is retried, not surfaced as a lost turn. The cost cap already
    # lives in --max-tokens; this bounds transient failures.
    client = boto3.client("bedrock-runtime", region_name=args.region,
                          config=Config(retries={"max_attempts": 4, "mode": "adaptive"}))
    try:
        resp = client.converse(
            modelId=args.model,
            messages=[{"role": "user", "content": [{"text": prompt}]}],
            inferenceConfig={"maxTokens": args.max_tokens},
        )
    except Exception as exc:
        sys.stderr.write(f"claude-bedrock-json: bedrock converse failed: {exc}\n")
        return 2

    env = to_envelope(resp, args.model)
    if not (env["answer"] or "").strip():       # no fallback — empty generation is a failure
        sys.stderr.write(f"claude-bedrock-json: empty answer (stopReason={resp.get('stopReason')})\n")
        return 3
    sys.stdout.write(json.dumps(env, ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
