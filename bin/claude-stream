#!/usr/bin/env python3
# Copyright (C) 2026 Sensata Research GmbH
# SPDX-License-Identifier: AGPL-3.0-only
"""Streaming synthesis adapter for the Claude CLI. Reads a prompt on stdin, runs
`claude -p … --output-format stream-json --include-partial-messages --verbose`,
and re-emits the answer as NDJSON on stdout: zero or more {"event":"token"} lines
as text deltas arrive, then one {"event":"done"} carrying model/usage/cost. A
Claude-reported error becomes one {"event":"error","kind":"synthesis_failed"} and
exit 1. The coupling to the Claude CLI's streaming JSON shape lives HERE, in the
machine binding, not in the engine — the engine reads only this normalized NDJSON."""
import json
import subprocess
import sys


def _emit(obj):
    sys.stdout.write(json.dumps(obj, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def main() -> int:
    prompt = sys.stdin.buffer.read()
    cmd = ["claude", "-p", *sys.argv[1:], "--output-format", "stream-json",
           "--include-partial-messages", "--verbose"]
    proc = subprocess.Popen(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE)
    proc.stdin.write(prompt)
    proc.stdin.close()
    for raw in proc.stdout:                       # line-buffered; one JSON object per line
        line = raw.decode(errors="replace").strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except json.JSONDecodeError:
            continue                              # a non-JSON banner line — skip, never crash
        mtype = msg.get("type")
        if mtype == "stream_event":
            ev = msg.get("event", {})
            if ev.get("type") == "content_block_delta":
                delta = ev.get("delta", {})
                if delta.get("type") == "text_delta":
                    _emit({"event": "token", "text": delta.get("text", "")})
        elif mtype == "result":
            if msg.get("is_error"):
                _emit({"event": "error", "kind": "synthesis_failed",
                       "detail": str(msg.get("result"))})
                proc.wait()
                return 1
            usage = msg.get("usage", {})
            _emit({"event": "done",
                   "model": next(iter(msg.get("modelUsage", {})), None),
                   "usage": {"input_tokens": usage.get("input_tokens"),
                             "output_tokens": usage.get("output_tokens"),
                             "cache_read_input_tokens": usage.get("cache_read_input_tokens")},
                   "cost_usd": msg.get("total_cost_usd")})
    code = proc.wait()
    if code != 0:
        _emit({"event": "error", "kind": "synthesis_failed",
               "detail": proc.stderr.read().decode(errors="replace").strip() or "claude failed"})
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
